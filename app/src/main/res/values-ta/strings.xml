    <!-- Promises made to the user -->
    <string name="promise_anonymity_title">உங்கள் பெயர் ஒருபோதும் காட்டப்படாது</string>
    <string name="promise_anonymity_body">வழக்கறிஞர்கள் உங்கள் கேள்வியை மட்டுமே பார்க்கிறார்கள். நீங்கள் யார் என்பதை அவர்களால் பார்க்க முடியாது, மற்ற குடிமக்களால் இந்தக் கேள்வியையே பார்க்க முடியாது.\n\nஒரு விஷயம்: நீங்களே தட்டச்சு செய்யும் விவரங்களை எங்களால் நீக்க முடியாது. எனவே கீழே உங்கள் பெயர், தொலைபேசி எண் அல்லது முகவரியைக் குறிப்பிட வேண்டாம்.</string>
    <string name="promise_contact_title">தொடர்பு எப்படி வேலை செய்கிறது</string>
    <string name="promise_contact_body">வழக்கறிஞர்களின் தொலைபேசி எண்களையோ மின்னஞ்சல் முகவரிகளையோ நாங்கள் வெளியிடுவதில்லை. ஒரு கோரிக்கையை அனுப்புங்கள்; அவர்கள் ஏற்றுக்கொண்டால், அவர்களின் விவரங்கள் \"என் கோரிக்கைகள்\" பகுதியில் தோன்றும்.</string>
    <string name="promise_answers_independent">வழக்கறிஞர்கள் தனித்தனியாக பதிலளிக்கிறார்கள்; ஒருவரின் பதிலை மற்றவரால் பார்க்க முடியாது. எனவே வெவ்வேறு கருத்துகள் இயல்பானவை. இவை பொதுவான சட்டத் தகவல்கள், உங்கள் வழக்குக்கான முறையான ஆலோசனை அல்ல.</string>
    <string name="promise_extraction_advisory">நீங்கள் தேர்வு செய்யும் வரை எதுவும் சேமிக்கப்படாது. தவறானவற்றைத் திருத்துங்கள் — இந்த விவரங்கள்தான் உங்களுக்கு எந்தத் திட்டங்கள் காட்டப்படும் என்பதைத் தீர்மானிக்கின்றன.</string>
    <string name="promise_audit_recorded">இந்த ஆவணத்தைத் திறந்தது தணிக்கை பதிவில் பதிவு செய்யப்பட்டுள்ளது.</string>


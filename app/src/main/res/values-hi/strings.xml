    <!-- Promises made to the user -->
    <string name="promise_anonymity_title">आपका नाम कभी नहीं दिखाया जाता</string>
    <string name="promise_anonymity_body">वकील केवल आपका प्रश्न देखते हैं। वे यह नहीं देख सकते कि आप कौन हैं, और अन्य नागरिक यह प्रश्न बिल्कुल नहीं देख सकते।\n\nएक बात ध्यान रखें: जो विवरण आप स्वयं लिखते हैं उन्हें हम हटा नहीं सकते, इसलिए नीचे अपना नाम, फ़ोन नंबर या पता न लिखें।</string>
    <string name="promise_contact_title">संपर्क कैसे काम करता है</string>
    <string name="promise_contact_body">हम वकीलों के फ़ोन नंबर या ईमेल पते प्रकाशित नहीं करते। अनुरोध भेजें, और यदि वे स्वीकार करते हैं तो उनके विवरण \"मेरे अनुरोध\" में दिखाई देंगे।</string>
    <string name="promise_answers_independent">वकील स्वतंत्र रूप से उत्तर देते हैं और एक-दूसरे के उत्तर नहीं देख सकते, इसलिए अलग-अलग राय सामान्य है। ये सामान्य कानूनी जानकारी हैं, आपके मामले पर औपचारिक सलाह नहीं।</string>
    <string name="promise_extraction_advisory">जब तक आप चुनते नहीं, कुछ भी सहेजा नहीं जाता। जो गलत है उसे ठीक करें — ये विवरण तय करते हैं कि आपको कौन सी योजनाएँ दिखाई जाएँगी।</string>
    <string name="promise_audit_recorded">इस दस्तावेज़ को खोलना ऑडिट लॉग में दर्ज कर लिया गया है।</string>


# Postgres connection string (Neon recommended).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Comma-separated allowlist of browser origins. Leave unset for mobile-only use;
# set it before exposing the admin routes to a web client.
# CORS_ORIGINS=https://admin.example.com

# Promotes this existing username to ADMIN on the next `npm run migrate`.
# There is deliberately no admin-signup endpoint — that would be a permanent
# backdoor. Leave unset once the first admin exists.
# BOOTSTRAP_ADMIN_USERNAME=

# Google Gemini API key. SERVER-SIDE ONLY — this must never be shipped to a
# client. Without it, AI endpoints return 503 and the app falls back to its
# deterministic explanations, which is a supported mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=25000

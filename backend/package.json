{
  "name": "urimai-backend",
  "version": "1.0.0",
  "description": "Prototype backend API for the Urimai app — auth, profile, and document storage backed by Postgres (Neon).",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test:surface": "node test/answerSurface.test.js",
    "test:isolation": "node test/isolation.test.js",
    "test": "npm run test:surface",
    "test:directory": "node test/directory.test.js",
    "test:all": "npm run test:surface && npm run test:token && npm run test:isolation && npm run test:directory",
    "dev:test": "node -e \"process.env.RATE_LIMIT_DISABLED='true';require('./src/server.js')\"",
    "test:token": "node test/tokenFreshness.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.12.0"
  }
}
